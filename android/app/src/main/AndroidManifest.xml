<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- muchi:// deep links: native Google OAuth returns the session
                 token via muchi://auth/success?token=… (and
                 muchi://youtube/success). Capacitor emits appUrlOpen. -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="muchi" />
            </intent-filter>

        </activity>

        <!-- MUCHI background audio: Media3 foreground service (kept playing
             with screen locked / app in background; OS media notification +
             lock-screen controls). Typed as mediaPlayback (Android 14+). -->
        <service
            android:name=".MuchiAudioService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions: only what MUCHI genuinely needs.
         INTERNET        — API + streaming.
         WAKE_LOCK       — keep the device from sleeping during playback.
         FOREGROUND_SERVICE + FOREGROUND_SERVICE_MEDIA_PLAYBACK
                         — media notification / background playback
                           (Android 14+ requires the typed permission).
         POST_NOTIFICATIONS — runtime-permission media/notification on
                           Android 13+; requested at a sensible moment
                           (first download), never on first launch. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Downloads / saving a song. Requested at runtime the first time you
         save (item 7). Android 10+ (API 29+) writes through scoped MediaStore
         and does NOT need this permission, so it is capped at API 28 to avoid
         a pointless legacy prompt on modern devices. -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" />

    <!-- v1.5.4 in-app updater: after MUCHI downloads its own update APK it
         hands the file to the system package installer ("Install unknown apps"
         for THIS app). This is a normal-protection permission the user still
         confirms in system settings; it is NOT granted silently and is only
         used to install MUCHI's own signed update, never anything else. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
</manifest>
