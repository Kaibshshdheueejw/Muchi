+    private void copy(HttpURLConnection con, OutputStream out) throws IOException {
+        try (InputStream in = con.getInputStream()) {
+            byte[] buf = new byte[64 * 1024];
+            int n;
+            while ((n = in.read(buf)) > 0) {
+                out.write(buf, 0, n);
+            }
+        }
+    }
