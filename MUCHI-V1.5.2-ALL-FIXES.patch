+            exit 1
+          fi
+          node scripts/check-release.mjs --assert-release
+      - name: Clean Gradle cache and refresh dependencies
+        working-directory: android
+        run: |
+          ./gradlew clean --refresh-dependencies
+          rm -rf .gradle build app/build
