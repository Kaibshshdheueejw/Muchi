{
  "name": "muchi",
  "version": "1.10.2",
  "private": true,
  "description": "MUCHI — YouTube Music + Spotify-style player on Cloudflare Workers (D1 + KV). Official YouTube playback, Audius independent artists, live radio. Web (PWA) + Android + iOS (Capacitor).",
  "type": "module",
  "scripts": {
    "dev": "node server.js",
    "build": "node -e \"console.log('Build complete')\"",
    "start": "node server.js",
    "lint": "node --check server.js",
    "test": "node test/smoke.mjs && node --test test/integration-regressions.mjs",
    "smoketest": "node test/smoke.mjs",
    "test:live": "WRANGLER_DEV_URL=http://127.0.0.1:3000 node test/smoke.mjs",
    "setup": "node scripts/setup.mjs",
    "check:release": "node scripts/check-release.mjs",
    "mobile:sync": "cap sync",
    "mobile:sync:android": "cap sync android",
    "mobile:sync:ios": "cap sync ios",
    "mobile:add": "cap add android && cap add ios",
    "native:check": "node scripts/sync-native-bundle.mjs --check",
    "native:sync": "node scripts/sync-native-bundle.mjs"
  },
  "dependencies": {
    "@capacitor/app": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/local-notifications": "^8.0.0",
    "@capacitor/share": "^8.0.0",
    "@capacitor/splash-screen": "^8.0.0",
    "@capacitor/status-bar": "^8.0.0",
    "capacitor-music-controls-plugin": "^8.0.0",
    "express": "^5.3.0",
    "lottie-web": "^5.13.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/cli": "^8.0.0",
    "@capacitor/ios": "^8.0.0",
    "typescript": "^7.0.2",
    "wrangler": "^4.127.1"
  },
  "overrides": {
    "body-parser": "2.4.0",
    "proxy-addr": "2.0.8",
    "qs": "6.17.1"
  }
}
